# Copy to .env.local and fill in real values. Never commit .env.local.
#
# The site needs none of these to run — `npm run dev` works with no .env.local
# at all. Everything below is reserved for work that is not built yet, and is
# listed so the variable names are decided in one place rather than invented
# twice. Resend and Cloudinary entries were removed along with their unused
# dependencies; add them back with the feature, not before it.

# Supabase (reserved for future repository implementations — see
# core/contracts/repositories/*.contract.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chat assistant (server-only - never exposed to the browser). Get a free key
# from Google AI Studio: https://aistudio.google.com/apikey — use AI Studio,
# not Google Cloud Console/Vertex AI, which has no ongoing free tier.
# The widget still renders with no key set; it just shows a friendly
# "not configured yet" message instead of calling the API.
GEMINI_API_KEY=
